# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env (berisi rahasia).

# Port server lokal
PORT=3000

# Harus SAMA PERSIS dengan "Verify token" yang Anda isi di Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=sahabat_purchasing_rahasia_123

# App Secret: Meta App Dashboard > App settings > Basic > App secret
# Dipakai untuk memvalidasi header X-Hub-Signature-256 pada setiap POST
WHATSAPP_APP_SECRET=ganti_dengan_app_secret_anda
